">
<script>
    var flashPlayerUrl = 'http://localhost:4343/animation/414827163ad4eb60/player.swf',
        flashPlayerVars = {"movieOwner":"African+Vulture%E2%84%A2","movieOwnerId":"0uWOI2JiCdHU","movieId":playerMovieId,"movieLid":"13","movieTitle":"","movieDesc":"","userId":"","username":"","uemail":"","ut":"-1","numContact":"","apiserver":"http:\/\/localhost:4343\/","duration":"0","playcount":1,"thumbnailURL":thumbnailUrl,"copyable":"0","isPublished":"1","ctc":"go","tlang":"en_US","is_private_shared":"0","autostart":"0","appCode":"go","is_slideshow":"0","originalId":"0zEt_fo4L-5k","is_emessage":"0","storePath":"http:\/\/localhost:4343\/store\/3a981f5cb2739137\/<store>","clientThemePath":"http:\/\/localhost:4343\/static\/ad44370a650793d9\/<client_theme>","animationPath":"http:\/\/localhost:4343\/animation\/414827163ad4eb60\/","isEmbed":"0","refuser":null,"utm_source":null,"uid":null,"isTemplate":"0","showButtons":"1","chain_mids":"","averageRating":5,"ratingCount":"1","ad":1,"endStyle":0,"pwm":0,"s3base":"http:\/\/localhost:4343\/","initcb":"flashPlayerLoaded","showshare":false},
        h5PlayerElem = null,
        sceneDetails = {};

    // The global video aspect ratio is controlled by /api/settings/list.
    // settings.html uses these resolution values:
    //   0 = 14:9 (no aspect-ratio flag)
    //   1 = 16:9 (isWide="1")
    //   2 = 21:9 (isUltra="2")
    //   3 = 4:3  (isRetro="3")
    function applyPlayerResolution(value) {
        value = String(value == null ? '0' : value);
        playerResolution = value;

        switch (value) {
            case '3':
                playerAspect = { width: 4, height: 3, label: '4:3' };
                delete flashPlayerVars.isWide;
                delete flashPlayerVars.isUltra;
                flashPlayerVars.isRetro = '3';
                break;
            case '1':
                playerAspect = { width: 16, height: 9, label: '16:9' };
                delete flashPlayerVars.isRetro;
                delete flashPlayerVars.isUltra;
                flashPlayerVars.isWide = '1';
                break;
            case '2':
                playerAspect = { width: 21, height: 9, label: '21:9' };
                delete flashPlayerVars.isRetro;
                delete flashPlayerVars.isWide;
                flashPlayerVars.isUltra = '2';
                break;
            case '0':
            default:
                playerResolution = '0';
                playerAspect = { width: 14, height: 9, label: '14:9' };
                delete flashPlayerVars.isRetro;
                delete flashPlayerVars.isWide;
                delete flashPlayerVars.isUltra;
                break;
        }

        var wrapper = document.querySelector('.video-player-wrapper');
        if (wrapper) {
            // Remove Bootstrap's fixed 16:9 pseudo-element behaviour and use
            // the actual configured aspect ratio instead.
            wrapper.classList.remove('embed-responsive-16by9');
            wrapper.style.paddingTop = (playerAspect.height / playerAspect.width * 100) + '%';
        }

        var videoHeight = document.querySelector('meta[name="video_height"]');
        var videoWidth = document.querySelector('meta[name="video_width"]');
        if (videoHeight) videoHeight.setAttribute('content', String(Math.round(720 * playerAspect.height / playerAspect.width)));
        if (videoWidth) videoWidth.setAttribute('content', '1280');

        var schemaHeight = document.querySelector('meta[itemprop="height"]');
        var schemaWidth = document.querySelector('meta[itemprop="width"]');
        if (schemaHeight) schemaHeight.setAttribute('content', String(Math.round(720 * playerAspect.height / playerAspect.width)));
        if (schemaWidth) schemaWidth.setAttribute('content', '1280');
    }

    function loadPlayerResolution(done) {
        var req = new XMLHttpRequest();
        req.open('GET', '/api/settings/list', true);
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;

            var value = '0';
            if (req.status >= 200 && req.status < 300) {
                try {
                    var settings = JSON.parse(req.responseText);
                    value = settings && settings.resolution != null ? settings.resolution : '0';
                } catch (e) {
                    console.warn('player.eta: unable to parse /api/settings/list:', e);
                }
            } else {
                console.warn('player.eta: /api/settings/list returned HTTP ' + req.status + '; using 14:9.');
            }

            applyPlayerResolution(value);
            if (typeof done === 'function') done();
        };
        req.send();
    }

    function createFlashPlayer() {
        var container = document.getElementById('flash-player');
        if (!container || !playerMovieId) return;

        applyPlayerResolution(playerResolution);

        var object = document.createElement('object');
        object.data = flashPlayerUrl;
        object.type = 'application/x-shockwave-flash';
        object.id = 'Player';
        object.width = '100%';
        object.height = '100%';

        function addParam(name, value) {
            var param = document.createElement('param');
            param.name = name;
            param.value = value;
            object.appendChild(param);
        }

        addParam('bgcolor', '#000000');
        addParam('scale', 'exactfit');
        addParam('allowScriptAccess', 'always');
        addParam('allowFullScreen', 'true');
        addParam('wmode', 'opaque');

        var vars = [];
        Object.keys(flashPlayerVars).forEach(function(key) {
            var value = flashPlayerVars[key];
            if (value === null || value === undefined) return;
            vars.push(encodeURIComponent(key) + '=' + encodeURIComponent(String(value)));
        });
        addParam('flashvars', vars.join('&'));

        container.innerHTML = '';
        container.appendChild(object);

        var viewport = document.getElementById('video-player-viewport');
        if (viewport) {
            viewport.style.backgroundImage = "url('" + thumbnailUrl + "')";
        }

        var thumbnail = document.getElementById('movie-thumbnail');
        if (thumbnail) {
            thumbnail.style.backgroundImage = "url('" + thumbnailUrl + "')";
        }
    }

    // Load the same movie list used by list.html, after the page DOM exists.
    // Use XMLHttpRequest here because list.html uses the same mechanism.
    function loadMovieMetadata() {
        if (!playerMovieId) {
            console.error('player.eta: no movieId supplied in the URL.');
            return;
        }

        var req = new XMLHttpRequest();
        req.open('GET', '/movieList', true);
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;

            if (req.status < 200 || req.status >= 300) {
                console.error('player.eta: /movieList returned HTTP ' + req.status);
                return;
            }

            try {
                var list = JSON.parse(req.responseText);
                var tbl = Array.isArray(list) ? list.find(function (item) {
                    return item && String(item.id) === String(playerMovieId);
                }) : null;

                if (!tbl) {
                    console.error('player.eta: playerMovieId "' + playerMovieId + '" was not found in /movieList.');
                    console.log('player.eta: /movieList response:', list);
                    return;
                }

                movieInfo = tbl;

                var title = tbl.title || playerMovieId || 'Untitled Video';
                var date = tbl.date ? String(tbl.date).substr(0, 10) + ' ' + String(tbl.date).substr(11) : 'Unknown';

                document.title = title + ' - Vyond Remastered';

                var titleEl = document.getElementById('movie-title');
                if (titleEl) titleEl.textContent = title;

                var titleInput = document.getElementById('movie-title-input');
                if (titleInput) titleInput.value = title;

                var dateEl = document.getElementById('movie-date');
                if (dateEl) dateEl.textContent = 'Last modified: ' + date;

                var descEl = document.getElementById('movie-description');
                if (descEl) descEl.textContent = tbl.description || '';

                var info = document.querySelector('.video-info');
                if (info) {
                    info.setAttribute('data-video-id', playerMovieId);
                    info.setAttribute('data-owner', tbl.owner || '');
                    info.setAttribute('data-duration', tbl.duration || '');
                }

                if (typeof flashPlayerVars !== 'undefined') {
                    flashPlayerVars.movieTitle = title;
                    flashPlayerVars.movieDesc = tbl.description || '';
                    flashPlayerVars.duration = tbl.duration || '0';
                }

                var metaTitle = document.getElementById('meta-title');
                if (metaTitle) metaTitle.setAttribute('content', title);

                var metaDescription = document.getElementById('meta-description');
                if (metaDescription) metaDescription.setAttribute('content', 'Watch the video: ' + title + ' on Vyond Remastered.');

                var ogTitle = document.querySelector('meta[property="og:title"]');
                if (ogTitle) ogTitle.setAttribute('content', title);

                var ogDescription = document.querySelector('meta[property="og:description"]');
                if (ogDescription) ogDescription.setAttribute('content', tbl.description || '');

                var ogImage = document.querySelector('meta[property="og:image"]');
                if (ogImage) ogImage.setAttribute('content', window.location.origin + thumbnailUrl);

                var twitterTitle = document.querySelector('meta[name="twitter:title"]');
                if (twitterTitle) twitterTitle.setAttribute('content', title);

                var twitterDescription = document.querySelector('meta[name="twitter:description"]');
                if (twitterDescription) twitterDescription.setAttribute('content', 'Watch the video: ' + title + ' on Vyond Remastered.');

                var twitterImage = document.querySelector('meta[name="twitter:image"]');
                if (twitterImage) twitterImage.setAttribute('content', window.location.origin + thumbnailUrl);

                // If the Flash object has not been created yet, create it now with the real title/duration.
                if (!document.getElementById('Player')) createFlashPlayer();
            } catch (e) {
                console.error('player.eta: unable to parse /movieList:', e, req.responseText);
            }
        };
        req.send();
    }

    // Create the Flash player independently of metadata, then update metadata when /movieList returns.
    function initializeLocalMoviePage() {
        // Load the configured aspect ratio first so the FlashVars and viewport
        // are correct before the SWF is instantiated.
        loadPlayerResolution(function () {
            if (playerMovieId && !document.getElementById('Player')) createFlashPlayer();
        });
        loadMovieMetadata();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeLocalMoviePage);
    } else {
        initializeLocalMoviePage();
    }

    // The player is created on DOMContentLoaded; movie metadata is applied asynchronously.
</script>
